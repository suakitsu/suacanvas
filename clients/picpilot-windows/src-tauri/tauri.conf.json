{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicPilot",
  "version": "1.0.0",
  "identifier": "com.suakitsu.picpilot",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "GraphicsAndDesign",
    "copyright": "Copyright 2026 PicPilot",
    "shortDescription": "PicPilot AI Commerce Studio",
    "longDescription": "Create ecommerce images, localized assets and product videos with PicPilot.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
