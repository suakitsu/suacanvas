                    <!-- Settings -->
                    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Style="{StaticResource PageTitle}" Text="个人资料与设置" /><TextBlock Style="{StaticResource MutedText}" Text="管理账号资料、界面语言与显示偏好。" Margin="0,7,0,20" />
                        <Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="邮箱" /><TextBox Text="{Binding CurrentUser.DisplayEmail, Mode=OneWay}" IsReadOnly="True" /><TextBlock Style="{StaticResource FieldLabel}" Text="昵称" Margin="0,14,0,6" /><TextBox Text="{Binding ProfileNickname}" /><TextBlock Style="{StaticResource FieldLabel}" Text="语言" Margin="0,14,0,6" /><ComboBox SelectedValue="{Binding ProfileLanguage}" SelectedValuePath="Tag"><ComboBoxItem Content="简体中文" Tag="zh-CN" /><ComboBoxItem Content="English" Tag="en-US" /><ComboBoxItem Content="日本語" Tag="ja-JP" /></ComboBox><TextBlock Style="{StaticResource FieldLabel}" Text="主题" Margin="0,14,0,6" /><ComboBox SelectedValue="{Binding ProfileTheme}" SelectedValuePath="Tag"><ComboBoxItem Content="跟随系统" Tag="system" /><ComboBoxItem Content="浅色" Tag="light" /><ComboBoxItem Content="深色" Tag="dark" /></ComboBox><Button Style="{StaticResource PrimaryButton}" Content="保存设置" Command="{Binding SaveProfileCommand}" Margin="0,18,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="本地图片与窗口" /><TextBlock Text="生成完成后可自动保存到电脑。缩略图和大图会优先读取本地文件，本地缺失时继续使用网站图片。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" /><CheckBox Content="自动保存新生成的图片" IsChecked="{Binding AutoDownloadImages}" Click="AutoDownloadToggle_Click" /><CheckBox Content="关闭或最小化窗口时保留在系统托盘" IsChecked="{Binding MinimizeToTray}" Click="MinimizeToTrayToggle_Click" Margin="0,13,0,0" /><TextBlock Style="{StaticResource FieldLabel}" Text="默认保存位置" Margin="0,14,0,6" /><TextBox Text="{Binding DownloadDirectory}" IsReadOnly="True" /><WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource ButtonBase}" Content="选择文件夹" Click="ChooseDownloadFolder_Click" /><Button Style="{StaticResource ButtonBase}" Content="打开文件夹" Click="OpenDownloadFolder_Click" Margin="8,0,0,0" /><Button Style="{StaticResource ButtonBase}" Content="同步已有图片" Click="SyncCompletedImages_Click" Margin="8,0,0,0" /></WrapPanel><TextBlock Text="{Binding LocalMediaStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border>
                    </StackPanel><Border Grid.Column="1" Style="{StaticResource PanelBorder}" VerticalAlignment="Top"><StackPanel><Image Source="Assets/picpilot.ico" Width="54" Height="54" HorizontalAlignment="Left" /><TextBlock Text="PicPilot for Windows" FontSize="18" FontWeight="Bold" Margin="0,14,0,0" /><TextBlock Text="版本 2.0.2" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /><Separator Margin="0,16" /><TextBlock Text="账号服务" FontWeight="SemiBold" /><TextBlock Text="{Binding BaseUrl}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /><TextBlock Text="在电脑端管理项目、生成任务、素材、视频和积分记录。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" /></StackPanel></Border></Grid></ScrollViewer></TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Native history detail drawer -->
        <Grid Background="#660F172A" Panel.ZIndex="70" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="680" HorizontalAlignment="Right" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="记录详情" FontSize="19" FontWeight="Bold" /><TextBlock Text="按所选 ID 加载，不会跳到最近任务" Foreground="{StaticResource MutedBrush}" FontSize="12" /></StackPanel><Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="关闭" Command="{Binding CloseDetailCommand}" VerticalAlignment="Center" /></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,8,22,24">
                        <StackPanel Visibility="{Binding SelectedProjectDetail, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding SelectedProjectDetail.Project.DisplayName}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedProjectDetail.Project.Id}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            <UniformGrid Columns="3" Margin="0,18,0,0"><Border Style="{StaticResource PanelBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="状态" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding SelectedProjectDetail.Project.Summary}" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border><Border Style="{StaticResource PanelBorder}" Margin="4,0"><StackPanel><TextBlock Text="图片" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding SelectedProjectDetail.Project.TotalImages}" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border><Border Style="{StaticResource PanelBorder}" Margin="8,0,0,0"><StackPanel><TextBlock Text="消耗" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding SelectedProjectDetail.Project.CreditsCost, StringFormat={}{0} 积分}" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border></UniformGrid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="图片任务" Margin="0,22,0,8" />
                            <ItemsControl ItemsSource="{Binding SelectedProjectDetail.ImageTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Width="52" Height="52" Padding="0" Style="{StaticResource ButtonBase}" Background="{StaticResource PanelAltBrush}" IsEnabled="{Binding HasResult}" Command="{Binding DataContext.PreviewImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="点击查看大图"><Image Source="{Binding ResultUrl, Converter={StaticResource MediaDisplayUri}}" Stretch="UniformToFill" /></Button><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{Binding ImageName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Id}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SafeError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxHeight="42" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" /><WrapPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource ButtonBase}" Content="预览" IsEnabled="{Binding HasResult}" ToolTip="{Binding ResultActionHint}" Command="{Binding DataContext.PreviewImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Style="{StaticResource ButtonBase}" Content="下载" IsEnabled="{Binding HasResult}" ToolTip="{Binding ResultActionHint}" Command="{Binding DataContext.DownloadImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="6,0,0,0" /><Button Style="{StaticResource ButtonBase}" Content="重试" IsEnabled="{Binding CanRetry}" Command="{Binding DataContext.RetryImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="6,0,0,0" /><Button Style="{StaticResource ButtonBase}" Content="移除" IsEnabled="{Binding CanHide}" Command="{Binding DataContext.HideImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="6,0,0,0" /></WrapPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SelectedCreativeChatDetail, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding SelectedCreativeChatDetail.Chat.Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedCreativeChatDetail.Chat.Summary}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="对话消息" />
                            <ItemsControl ItemsSource="{Binding SelectedCreativeChatDetail.Messages}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" /><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,7,0,0" /><Button Width="220" Height="220" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="0" Style="{StaticResource ButtonBase}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" Command="{Binding DataContext.PreviewChatMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="点击查看大图"><Image Source="{Binding ResultUrl, Converter={StaticResource MediaDisplayUri}}" Stretch="Uniform" /></Button><WrapPanel Margin="0,10,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource ButtonBase}" Content="预览" Command="{Binding DataContext.PreviewChatMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Style="{StaticResource ButtonBase}" Content="下载" Command="{Binding DataContext.DownloadChatMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,0,0,0" /></WrapPanel><TextBlock Text="{Binding DisplayCreatedAt}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="生成版本" Margin="0,18,0,8" />
                            <ItemsControl ItemsSource="{Binding SelectedCreativeChatDetail.Versions}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Width="48" Height="48" Padding="0" Style="{StaticResource ButtonBase}" Background="{StaticResource PanelAltBrush}" IsEnabled="{Binding HasResult}" Command="{Binding DataContext.PreviewChatVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="点击查看大图"><Image Source="{Binding ResultUrl, Converter={StaticResource MediaDisplayUri}}" Stretch="UniformToFill" /></Button><StackPanel Grid.Column="1"><TextBlock Text="{Binding VersionNo, StringFormat=版本 {0}}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding SafeError}" Foreground="{StaticResource DangerBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><WrapPanel Grid.Column="2" VerticalAlignment="Center"><Button Style="{StaticResource ButtonBase}" Content="预览" IsEnabled="{Binding HasResult}" Command="{Binding DataContext.PreviewChatVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Style="{StaticResource ButtonBase}" Content="下载" IsEnabled="{Binding HasResult}" Command="{Binding DataContext.DownloadChatVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,0,0,0" /></WrapPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </StackPanel></ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- In-window image lightbox -->
        <Grid x:Name="ImagePreviewOverlay" Background="#E60B1020" Panel.ZIndex="120" Visibility="Collapsed" MouseLeftButtonDown="ImagePreviewOverlay_MouseLeftButtonDown">
            <Grid Margin="28">
                <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="图片预览" Foreground="White" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ImagePreviewName" Foreground="#B8C3D5" TextTrimming="CharacterEllipsis" MaxWidth="620" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonBase}" Content="下载" Click="ImagePreviewDownload_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ButtonBase}" Width="38" Height="38" Padding="0" Click="ImagePreviewClose_Click" ToolTip="关闭预览" AutomationProperties.Name="关闭图片预览"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" /></Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#080C14" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <ScrollViewer x:Name="ImagePreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both" PreviewMouseWheel="ImagePreviewScroll_PreviewMouseWheel">
                        <Grid MinWidth="400" MinHeight="300"><Image x:Name="ImagePreview" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"><Image.LayoutTransform><ScaleTransform ScaleX="{Binding ElementName=ImagePreviewZoom, Path=Value}" ScaleY="{Binding ElementName=ImagePreviewZoom, Path=Value}" /></Image.LayoutTransform></Image></Grid>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Esc 关闭 · Ctrl + 滚轮缩放" Foreground="#AAB5C7" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource ButtonBase}" Content="适应窗口" Click="ImagePreviewFit_Click" /><Button Style="{StaticResource ButtonBase}" Content="1:1" Click="ImagePreviewActual_Click" Margin="8,0,0,0" /><TextBlock Text="缩放" Foreground="White" VerticalAlignment="Center" Margin="16,0,8,0" /><Slider x:Name="ImagePreviewZoom" Minimum="0.1" Maximum="6" Value="1" Width="180" /></StackPanel>
                    <TextBlock Grid.Column="2" x:Name="ImagePreviewDimensions" Foreground="#AAB5C7" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Native feedback surfaces -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" Panel.ZIndex="80">
            <Border x:Name="ErrorToast" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,78,28,0" Background="#FFF9F8" BorderBrush="#F3C7C3" BorderThickness="1" CornerRadius="8" Padding="16,12" MaxWidth="520"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" /></Border.Effect>
                <StackPanel Orientation="Horizontal"><Border Width="26" Height="26" CornerRadius="6" Background="#FDE7E5"><TextBlock Text="!" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="10,3,0,0" /></StackPanel>
            </Border>
            <Border x:Name="SuccessToast" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,78,28,0" Background="#F4FBF8" BorderBrush="#B7E4D2" BorderThickness="1" CornerRadius="8" Padding="16,12" MaxWidth="520"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibility}}">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.14" /></Border.Effect>
                <StackPanel Orientation="Horizontal"><Border Width="26" Height="26" CornerRadius="6" Background="#DDF4E9"><TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="10,3,0,0" /></StackPanel>
            </Border>
        </Grid>
        <Border x:Name="BusyToast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Panel.ZIndex="100"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.18" /></Border.Effect>
            <StackPanel Width="230"><TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" /><ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" /></StackPanel>
        </Border>
    </Grid>
</Window>
