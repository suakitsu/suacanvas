ontent="关闭" IsEnabled="{Binding CanClose}" Command="{Binding DataContext.CancelRechargeOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,0,0,0" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
