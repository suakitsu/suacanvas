                                    </DockPanel></Border>
                                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,24">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="对话生图" /><TextBlock Text="在同一对话中继续修改，历史版本和参考关系会保留。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel><Border Grid.Column="1" Background="{StaticResource PrimarySoftBrush}" CornerRadius="7" Padding="12,8" VerticalAlignment="Top"><TextBlock Text="{Binding ActiveAiChatTitle}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MaxWidth="230" TextTrimming="CharacterEllipsis" /></Border></Grid>
                                        <ItemsControl ItemsSource="{Binding SelectedCreativeChatDetail.Messages}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Role}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,6,0,0" /><Button Width="280" Height="280" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="0" Style="{StaticResource ButtonBase}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" Command="{Binding DataContext.PreviewChatMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="点击查看大图"><Image Source="{Binding ResultUrl, Converter={StaticResource MediaDisplayUri}}" Stretch="Uniform" /></Button></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0"><StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="继续告诉 AI 要生成或修改什么 *" /><TextBox Text="{Binding AiPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="112" VerticalContentAlignment="Top" />
                                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="视觉风格" /><TextBox Text="{Binding AiStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="输出尺寸" /><ComboBox ItemsSource="{Binding AiSizes}" SelectedItem="{Binding AiSize}" /></StackPanel></Grid>
                                            <WrapPanel Margin="0,13,0,0"><Button Style="{StaticResource ButtonBase}" Content="添加参考图片" Click="ChooseAiReferences_Click" /><Button Style="{StaticResource ButtonBase}" Content="清空" Click="ClearAiReferences_Click" Margin="8,0,0,0" /><TextBlock Text="{Binding AiReferencePaths.Count, StringFormat=已选择 {0} 张}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" /></WrapPanel>
                                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Style="{StaticResource ButtonBase}" Content="估算积分" Command="{Binding EstimateAiCommand}" /><TextBlock Grid.Column="1" Text="{Binding AiEstimateText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0" /><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="确认并发送" Command="{Binding GenerateAiCommand}" MinWidth="150" /></Grid>
                                        </StackPanel></Border>
                                    </StackPanel></ScrollViewer>
                                </Grid></TabItem>

                                <!-- Copy agent -->
                                <TabItem><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="文案 Agent" /><TextBlock Text="把商品资料和目标平台直接发来，适合标题、卖点、详情页与营销文案。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel><Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="清空对话" Command="{Binding ClearAssistantConversationCommand}" VerticalAlignment="Top" /></Grid>
                                        <ListBox Grid.Row="1" ItemsSource="{Binding AssistantConversation}" Margin="0,16,0,12" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,9"><StackPanel><TextBlock Text="{Binding DisplayRole}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
