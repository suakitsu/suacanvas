                        <ItemsControl ItemsSource="{Binding RechargePlans}" Margin="0,16,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Width="230" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Credits, StringFormat={}{0} 积分}" FontSize="24" FontWeight="Bold" Margin="0,10,0,0" /><TextBlock Text="{Binding PriceText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0" /><Button Style="{StaticResource ButtonBase}" Content="创建充值订单" Command="{Binding DataContext.PurchasePlanCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,14,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
