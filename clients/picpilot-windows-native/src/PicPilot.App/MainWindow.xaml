                        <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="图片项目" /><ListBox ItemsSource="{Binding ProjectsView}" Margin="0,10,0,0" MaxHeight="520" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Width="44" Height="44" Padding="0" Style="{StaticResource ButtonBase}" Background="{StaticResource PanelAltBrush}" IsEnabled="{Binding HasCover}" Command="{Binding DataContext.PreviewProjectCoverCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="点击查看大图"><Grid><TextBlock Text="图" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding CoverUrl, Converter={StaticResource MediaDisplayUri}}" Stretch="UniformToFill" /></Grid></Button><StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /><TextBlock Text="{Binding Id}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding CreditsCost, StringFormat={}{0} 积分}" VerticalAlignment="Center" /><WrapPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource ButtonBase}" Content="预览" IsEnabled="{Binding HasCover}" ToolTip="项目完成后可预览最近图片" Command="{Binding DataContext.PreviewProjectCoverCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Style="{StaticResource ButtonBase}" Content="详情" Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,0,0,0" /><Button Style="{StaticResource ButtonBase}" Content="移除" Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,0,0,0" /></WrapPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="AI 对话" /><ListBox ItemsSource="{Binding CreativeChatsView}" Margin="0,10,0,0" MaxHeight="360" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Id}" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center" /><WrapPanel Grid.Column="2"><Button Style="{StaticResource PrimaryButton}" Content="继续" Command="{Binding DataContext.ContinueCreativeChatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Style="{StaticResource ButtonBase}" Content="详情" Command="{Binding DataContext.OpenCreativeChatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,0,0,0" /></WrapPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
