<Window x:Class="PicPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="PicPilot" Width="1440" Height="900" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Assets/picpilot.ico"
        SizeChanged="Window_SizeChanged" Closing="Window_Closing">
    <Grid Background="{StaticResource WindowBrush}">
        <!-- Native authentication -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="AuthHeroColumn" Width="1.15*" /><ColumnDefinition x:Name="AuthFormColumn" Width="0.85*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#102044">
                <Grid ClipToBounds="True">
                    <Image Source="Assets/login-commerce-studio.png" Stretch="UniformToFill" />
                    <Border Background="#66071328" />
                    <Grid Margin="56">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="8" Background="White"><Image Source="Assets/picpilot.ico" Margin="7" /></Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PicPilot" Foreground="White" FontSize="21" FontWeight="Bold" />
                                <TextBlock Text="AI COMMERCE STUDIO" Foreground="#C8D5F0" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
                            <Border Background="#CC071328" CornerRadius="8" Padding="24" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="一份商品资料，展开一套可投放内容" Foreground="White" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" LineHeight="50" />
                                    <TextBlock Margin="0,16,0,0" Text="主图、场景图、细节图、套图与视频，在同一工作台持续生产。" Foreground="#D6E1F5" FontSize="16" TextWrapping="Wrap" LineHeight="25" />
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="3" Margin="0,18,0,0">
                                <Border Background="#D9071328" CornerRadius="7" Padding="14" Margin="0,0,7,0"><StackPanel><TextBlock Text="10,000+" Foreground="White" FontSize="18" FontWeight="Bold" /><TextBlock Text="累计商品图" Foreground="#C8D5F0" Margin="0,4,0,0" /></StackPanel></Border>
                                <Border Background="#D9071328" CornerRadius="7" Padding="14" Margin="3,0"><StackPanel><TextBlock Text="97.12%" Foreground="White" FontSize="18" FontWeight="Bold" /><TextBlock Text="图片任务成功率" Foreground="#C8D5F0" Margin="0,4,0,0" /></StackPanel></Border>
                                <Border Background="#D9071328" CornerRadius="7" Padding="14" Margin="7,0,0,0"><StackPanel><TextBlock Text="10+" Foreground="White" FontSize="18" FontWeight="Bold" /><TextBlock Text="覆盖电商平台" Foreground="#C8D5F0" Margin="0,4,0,0" /></StackPanel></Border>
                            </UniformGrid>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="PicPilot · AI 电商视觉工作台" Foreground="#B4C4E2" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border x:Name="AuthFormContent" Width="430" Padding="34" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding AuthTitle}" FontSize="28" FontWeight="Bold" />
                            <TextBlock Text="使用你的 PicPilot 账号继续" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,28" />

                            <Border Background="#FFF1F0" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="7" Padding="11"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            </Border>
                            <Border Background="#EAF7F1" BorderBrush="#B7E4D2" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,8,0,0"
                                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="邮箱" Margin="0,20,0,6" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="邮箱" />

                            <StackPanel Visibility="{Binding AuthNeedsPassword, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="密码" Margin="0,16,0,6" />
                                <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" AutomationProperties.Name="密码" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding AuthNeedsConfirmation, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="确认密码" Margin="0,16,0,6" />
                                <PasswordBox x:Name="ConfirmPasswordInput" PasswordChanged="ConfirmPasswordInput_PasswordChanged" AutomationProperties.Name="确认密码" />
                            </StackPanel>
                            <Grid Margin="0,16,0,0" Visibility="{Binding AuthNeedsCode, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="邮箱验证码" /><TextBox Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="邮箱验证码" /></StackPanel>
                                <Button Grid.Column="1" Margin="8,23,0,0" Style="{StaticResource ButtonBase}" Content="发送验证码" Command="{Binding SendCodeCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding CodeCooldown, StringFormat=验证码冷却：{0} 秒}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                                       Visibility="{Binding AuthNeedsCode, Converter={StaticResource BoolToVisibility}}" />

                            <CheckBox Content="保持登录状态" IsChecked="{Binding RememberMe}" Margin="0,18,0,0" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding AuthActionLabel}" Command="{Binding SubmitAuthCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,20,0,0" MinHeight="44" />

                            <UniformGrid Columns="3" Margin="0,18,0,0">
                                <Button Style="{StaticResource ButtonBase}" Content="密码登录" Command="{Binding SwitchAuthModeCommand}" CommandParameter="0" Margin="0,0,5,0" />
                                <Button Style="{StaticResource ButtonBase}" Content="验证码登录" Command="{Binding SwitchAuthModeCommand}" CommandParameter="1" Margin="3,0" />
                                <Button Style="{StaticResource ButtonBase}" Content="注册账号" Command="{Binding SwitchAuthModeCommand}" CommandParameter="2" Margin="5,0,0,0" />
                            </UniformGrid>
                            <Button Style="{StaticResource ButtonBase}" Content="忘记密码 / 重置密码" Command="{Binding SwitchAuthModeCommand}" CommandParameter="3" Margin="0,8,0,0" />
                            <TextBlock Text="密码为 8-16 位，必须同时包含字母和数字。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Native application shell -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Image Source="Assets/picpilot.ico" Width="34" Height="34" />
                        <StackPanel Margin="10,0,0,0" Tag="NavLabel" VerticalAlignment="Center">
                            <TextBlock Text="PicPilot" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="AI COMMERCE STUDIO" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8">
                            <Button Style="{StaticResource NavButton}" Background="{Binding SelectedPageIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=0}" Command="{Binding NavigateCommand}" CommandParameter="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30" /><TextBlock Tag="NavLabel" Text="工作台" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Background="{Binding SelectedPageIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=1}" Command="{Binding NavigateCommand}" CommandParameter="1"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30" /><TextBlock Tag="NavLabel" Text="电商制图" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Background="{Binding SelectedPageIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=2}" Command="{Binding NavigateCommand}" CommandParameter="2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30" /><TextBlock Tag="NavLabel" Text="商品视频" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Background="{Binding SelectedPageIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=3}" Command="{Binding NavigateCommand}" CommandParameter="3"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30" /><TextBlock Tag="NavLabel" Text="AI 创作" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Background="{Binding SelectedPageIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=4}" Command="{Binding NavigateCommand}" CommandParameter="4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C4;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30" /><TextBlock Tag="NavLabel" Text="AI 画布" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Background="{Binding SelectedPageIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=5}" Command="{Binding NavigateCommand}" CommandParameter="5"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30" /><TextBlock Tag="NavLabel" Text="历史记录" VerticalAlignment="Center" /></StackPanel></Button>
                            <Separator Margin="16,12" />
                            <Button Style="{StaticResource NavButton}" Background="{Binding SelectedPageIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=6}" Command="{Binding NavigateCommand}" CommandParameter="6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30" /><TextBlock Tag="NavLabel" Text="积分与充值" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Background="{Binding SelectedPageIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=7}" Command="{Binding NavigateCommand}" CommandParameter="7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30" /><TextBlock Tag="NavLabel" Text="站内信" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Background="{Binding SelectedPageIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=8}" Command="{Binding NavigateCommand}" CommandParameter="8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="30" /><TextBlock Tag="NavLabel" Text="个人资料与设置" VerticalAlignment="Center" /></StackPanel></Button>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Margin="12" Padding="10" Background="{StaticResource PanelAltBrush}" CornerRadius="7">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUser.DisplayEmail}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentUser.Credits, StringFormat={}{0} 积分}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <Button Style="{StaticResource ButtonBase}" Content="退出登录" Command="{Binding SignOutCommand}" Margin="0,10,0,0" Padding="8,5" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="16" Padding="12,6" Margin="0,0,8,0"><TextBlock Text="{Binding CurrentUser.Credits, StringFormat={}{0} 积分}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" /></Border>
                            <Button Style="{StaticResource ButtonBase}" Width="36" Height="36" Padding="0" Command="{Binding RefreshCurrentCommand}" ToolTip="刷新当前页面" AutomationProperties.Name="刷新当前页面"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="15" /></Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <ProgressBar Grid.Row="0" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True"
                             Visibility="{Binding IsPageLoading, Converter={StaticResource BoolToVisibility}}" />

                <TabControl x:Name="PageTabs" Grid.Row="1" SelectedIndex="{Binding SelectedPageIndex}" Background="Transparent" BorderThickness="0" SelectionChanged="PageTabs_SelectionChanged">
                    <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style></TabControl.Resources>

                    <!-- Workspace -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
                            <TextBlock Style="{StaticResource PageTitle}" Text="把今天的商品内容推进一步" />
                            <TextBlock Style="{StaticResource MutedText}" Text="套图、视频、自由创作与历史资产，都从这里继续。" Margin="0,7,0,22" />
                            <UniformGrid Columns="4">
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="8" Background="#EAF1FF"><TextBlock Text="&#xE8C7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="可用积分" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding DashboardCredits}" FontSize="26" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel></Grid></Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="3,0,7,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="8" Background="#E8F7F2"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="内容项目" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding DashboardProjectCount}" FontSize="26" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel></Grid></Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="7,0,3,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="8" Background="#FFF4DF"><TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" Foreground="#B7791F" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="进行中" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding DashboardRunningCount}" FontSize="26" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel></Grid></Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="10,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="8" Background="#F3EDFF"><TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="已完成图片" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding DashboardCompletedCount}" FontSize="26" FontWeight="Bold" Margin="0,5,0,0" /></StackPanel></Grid></Border>
                            </UniformGrid>
                            <UniformGrid Columns="4" Margin="0,18,0,0">
                                <Button Style="{StaticResource FeatureButton}" Command="{Binding NavigateCommand}" CommandParameter="1" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="平台套图" FontWeight="SemiBold" /><TextBlock Text="主图、卖点图与详情素材" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Grid></Button>
                                <Button Style="{StaticResource FeatureButton}" Command="{Binding NavigateCommand}" CommandParameter="3" Margin="3,0,5,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" Foreground="#7C3AED" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="AI 创作" FontWeight="SemiBold" /><TextBlock Text="生成、修改与版本沉淀" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Grid></Button>
                                <Button Style="{StaticResource FeatureButton}" Command="{Binding NavigateCommand}" CommandParameter="2" Margin="5,0,3,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" Foreground="#B7791F" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="商品视频" FontWeight="SemiBold" /><TextBlock Text="镜头脚本与动态展示" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Grid></Button>
                                <Button Style="{StaticResource FeatureButton}" Command="{Binding NavigateCommand}" CommandParameter="4" Margin="8,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7C4;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="AI 画布" FontWeight="SemiBold" /><TextBlock Text="自由编排创作流程" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Grid></Button>
                            </UniformGrid>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="最近项目" />
                                    <ListBox ItemsSource="{Binding Projects}" MaxHeight="430" Margin="0,12,0,0">
                                        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Width="42" Height="42" Padding="0" Style="{StaticResource ButtonBase}" Background="{StaticResource PrimarySoftBrush}" IsEnabled="{Binding HasCover}" Command="{Binding DataContext.PreviewProjectCoverCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="点击查看大图"><Grid><TextBlock Text="图" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding CoverUrl, Converter={StaticResource MediaDisplayUri}}" Stretch="UniformToFill" /></Grid></Button><StackPanel Grid.Column="1" Margin="10,0,14,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding DisplayUpdatedAt}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Grid.Column="3" Style="{StaticResource ButtonBase}" Content="预览" IsEnabled="{Binding HasCover}" ToolTip="预览最近完成图片" Command="{Binding DataContext.PreviewProjectCoverCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="继续" Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="8,0,0,0" /></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel></ScrollViewer>
                    </TabItem>

                    <!-- Commerce -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
                            <TextBlock Style="{StaticResource PageTitle}" Text="电商制图" />
                            <TextBlock Style="{StaticResource MutedText}" Text="从商品资料到平台套图与图片翻译，分步完成并统一管理结果。" Margin="0,7,0,18" />
                            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding CommerceWorkflows}" SelectedItem="{Binding SelectedCommerceWorkflow}" DisplayMemberPath="Name" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedCommerceWorkflow.Description}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                            </Grid>

                            <StackPanel Visibility="{Binding IsListingWorkflow, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource PanelBorder}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="1. 商品资料与 Listing 文案" /><TextBlock Text="先保存商品事实并生成文案；A+ 选择会在整个流程中保持。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel><Border Grid.Column="1" Background="{StaticResource PrimarySoftBrush}" CornerRadius="7" Padding="12,7"><TextBlock Text="{Binding ListingStep, StringFormat=第 {0}/3 步}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" /></Border></Grid>
                                        <UniformGrid Columns="2" Margin="0,16,0,0">
                                            <StackPanel Margin="0,0,7,12"><TextBlock Style="{StaticResource FieldLabel}" Text="商品名称 *" /><TextBox Text="{Binding ListingProductName}" /></StackPanel>
                                            <StackPanel Margin="7,0,0,12"><TextBlock Style="{StaticResource FieldLabel}" Text="品牌 *" /><TextBox Text="{Binding ListingBrand}" /></StackPanel>
                                            <StackPanel Margin="0,0,7,12"><TextBlock Style="{StaticResource FieldLabel}" Text="站点 / 国家" /><TextBox Text="{Binding ListingCountry}" /></StackPanel>
                                            <StackPanel Margin="7,0,0,12"><TextBlock Style="{StaticResource FieldLabel}" Text="输出语言" /><TextBox Text="{Binding ListingLanguage}" /></StackPanel>
                                            <StackPanel Margin="0,0,7,12"><TextBlock Style="{StaticResource FieldLabel}" Text="类目" /><TextBox Text="{Binding ListingCategory}" /></StackPanel>
                                            <StackPanel Margin="7,0,0,12"><TextBlock Style="{StaticResource FieldLabel}" Text="材质" /><TextBox Text="{Binding ListingMaterial}" /></StackPanel>
                                            <StackPanel Margin="0,0,7,12"><TextBlock Style="{StaticResource FieldLabel}" Text="尺寸 / 规格" /><TextBox Text="{Binding ListingDimensions}" /></StackPanel>
                                            <StackPanel Margin="7,0,0,12"><TextBlock Style="{StaticResource FieldLabel}" Text="标题关键词（逗号分隔）" /><TextBox Text="{Binding ListingKeywords}" /></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="商品描述" /><TextBox Text="{Binding ListingDescription}" AcceptsReturn="True" Height="84" VerticalContentAlignment="Top" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="视觉方向" Margin="0,12,0,6" /><TextBox Text="{Binding ListingVisualPrompt}" AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" />
                                        <UniformGrid Columns="2" Margin="0,12,0,0"><StackPanel Margin="0,0,7,0"><TextBlock Style="{StaticResource FieldLabel}" Text="卖点关键词" /><TextBox Text="{Binding ListingSellingKeywords}" /></StackPanel><StackPanel Margin="7,0,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="描述关键词" /><TextBox Text="{Binding ListingDescriptionKeywords}" /></StackPanel></UniformGrid>
                                        <CheckBox IsChecked="{Binding ListingIncludeAplus}" Margin="0,16,0,0"><StackPanel><TextBlock Text="同时生成 A+ 图" FontWeight="SemiBold" /><TextBlock Text="Listing 七图完成提交时，同步创建 1 张 A+ 模块图（额外 6 积分）" Foreground="{StaticResource MutedBrush}" FontSize="12" /></StackPanel></CheckBox>
                                        <UniformGrid Columns="2" Margin="0,12,0,0" Visibility="{Binding ListingIncludeAplus, Converter={StaticResource BoolToVisibility}}"><StackPanel Margin="0,0,7,0"><TextBlock Style="{StaticResource FieldLabel}" Text="A+ 模块" /><ComboBox ItemsSource="{Binding ListingAplusModules}" SelectedItem="{Binding ListingAplusModule}" /></StackPanel><StackPanel Margin="7,0,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="A+ 尺寸" /><ComboBox ItemsSource="{Binding ListingAplusSizes}" SelectedItem="{Binding ListingAplusSize}" /></StackPanel></UniformGrid>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="A+ 补充要求" Margin="0,12,0,6" Visibility="{Binding ListingIncludeAplus, Converter={StaticResource BoolToVisibility}}" /><TextBox Text="{Binding ListingAplusPrompt}" AcceptsReturn="True" Height="64" VerticalContentAlignment="Top" Visibility="{Binding ListingIncludeAplus, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="保存资料并生成 Listing 文案" Command="{Binding PrepareListingCommand}" Margin="0,16,0,0" HorizontalAlignment="Right" MinWidth="220" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0" Visibility="{Binding ListingProject, Converter={StaticResource NullToVisibility}}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="2. 核对文案、事实与参考图" /><TextBlock Text="确认事实可修改；它会约束后续七张图，不会把整段内部 JSON 暴露给最终用户。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel><Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="重新生成文案" Command="{Binding RegenerateListingCopyCommand}" /></Grid>
                                        <UniformGrid Columns="2" Margin="0,16,0,0"><StackPanel Margin="0,0,7,0"><TextBlock Style="{StaticResource FieldLabel}" Text="AI Listing 文案（预览）" /><TextBox Text="{Binding ListingGeneratedCopy}" IsReadOnly="True" AcceptsReturn="True" Height="220" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" /></StackPanel><StackPanel Margin="7,0,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="确认事实（可编辑 JSON）" /><TextBox Text="{Binding ListingFactsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="220" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" /></StackPanel></UniformGrid>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="商品参考图（第一张作为主图，最多 10 张）" Margin="0,16,0,6" /><WrapPanel><Button Style="{StaticResource ButtonBase}" Content="选择或继续添加" Click="ChooseListingReferences_Click" /><Button Style="{StaticResource ButtonBase}" Content="清空" Click="ClearListingReferences_Click" Margin="8,0,0,0" /><TextBlock Text="{Binding ListingReferencePaths.Count, StringFormat=已选择 {0} 张}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" /></WrapPanel>
                                        <ItemsControl ItemsSource="{Binding ListingReferencePaths}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="14" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ListingOutputLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentUser.Credits, StringFormat=当前余额：{0} 积分}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ListingCostText}" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" /></Grid></Border>
                                        <Button Style="{StaticResource PrimaryButton}" Content="确认并创建图片任务" Command="{Binding GenerateListingPackageCommand}" Margin="0,14,0,0" HorizontalAlignment="Right" MinWidth="210" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid Visibility="{Binding IsAplusWorkflow, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,18,0"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="A+ 商品与画面" /><UniformGrid Columns="2" Margin="0,16,0,0"><StackPanel Margin="0,0,7,10"><TextBlock Style="{StaticResource FieldLabel}" Text="商品名称" /><TextBox Text="{Binding AplusProductName}" /></StackPanel><StackPanel Margin="7,0,0,10"><TextBlock Style="{StaticResource FieldLabel}" Text="品牌" /><TextBox Text="{Binding AplusBrand}" /></StackPanel><StackPanel Margin="0,0,7,0"><TextBlock Style="{StaticResource FieldLabel}" Text="模块类型" /><ComboBox ItemsSource="{Binding AplusModules}" SelectedItem="{Binding AplusModule}" /></StackPanel><StackPanel Margin="7,0,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="输出尺寸" /><ComboBox ItemsSource="{Binding AplusSizes}" SelectedItem="{Binding AplusSize}" /></StackPanel></UniformGrid><TextBlock Style="{StaticResource FieldLabel}" Text="A+ 画面要求 *" Margin="0,14,0,6" /><TextBox Text="{Binding AplusPrompt}" AcceptsReturn="True" Height="140" VerticalContentAlignment="Top" /><WrapPanel Margin="0,14,0,0"><Button Style="{StaticResource ButtonBase}" Content="选择参考图片" Click="ChooseAplusReference_Click" /><Button Style="{StaticResource ButtonBase}" Content="清除" Click="ClearAplusReference_Click" Margin="8,0,0,0" /><TextBlock Text="{Binding AplusReferencePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" ToolTip="{Binding AplusReferencePath}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" /></WrapPanel></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" VerticalAlignment="Top"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="费用与提交" /><TextBlock Text="1 张 A+ 模块图" FontWeight="SemiBold" Margin="0,18,0,0" /><TextBlock Text="6 积分" FontSize="30" FontWeight="Bold" Margin="0,8,0,0" /><TextBlock Text="失败按服务端规则自动退款" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding CurrentUser.Credits, StringFormat=当前余额：{0} 积分}" Margin="0,16,0,0" /><Button Style="{StaticResource PrimaryButton}" Content="确认并生成 A+ 图" Command="{Binding GenerateAplusCommand}" Margin="0,18,0,0" /></StackPanel></Border>
                            </Grid>

                            <Grid Visibility="{Binding IsPlatformWorkflow, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <Border Style="{StaticResource PanelBorder}"><StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="1. 商品与素材" />
                                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="商品名称 *" /><TextBox Text="{Binding CommerceProductName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="品牌" /><TextBox Text="{Binding CommerceBrand, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        </Grid>
                                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="类目" /><TextBox Text="{Binding CommerceCategory}" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="材质" /><TextBox Text="{Binding CommerceMaterial}" /></StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="核心卖点（每行一个）" Margin="0,14,0,6" /><TextBox Text="{Binding CommerceSellingPoints}" AcceptsReturn="True" Height="86" VerticalContentAlignment="Top" />
                                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="规格参数" /><TextBox Text="{Binding CommerceSpecs}" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="目标人群" /><TextBox Text="{Binding CommerceAudience}" /></StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="使用场景" Margin="0,14,0,6" /><TextBox Text="{Binding CommerceScenario}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Style="{StaticResource ButtonBase}" Content="选择参考图片" Click="ChooseCommerceReferences_Click" /><Button Style="{StaticResource ButtonBase}" Content="清空" Click="ClearCommerceReferences_Click" Margin="8,0,0,0" /><TextBlock Text="{Binding CommerceReferencePaths.Count, StringFormat=已选择 {0} 张}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" /></StackPanel>
                                    </StackPanel></Border>
                                    <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="2. 平台与画面" /><TextBlock Style="{StaticResource FieldLabel}" Text="平台" Margin="0,15,0,6" /><ComboBox ItemsSource="{Binding CommercePlatforms}" SelectedItem="{Binding SelectedCommercePlatform}" DisplayMemberPath="Name" /><ItemsControl ItemsSource="{Binding CommerceSlots}" Margin="0,14,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,18,10"><StackPanel Width="190"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" /></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" VerticalAlignment="Top"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="3. 费用与提交" /><TextBlock Style="{StaticResource FieldLabel}" Text="输出清晰度" Margin="0,18,0,6" /><ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding CommerceResolution}" /><Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="预计消耗" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding CommerceEstimatedCost, StringFormat={}{0} 积分}" FontSize="28" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="{Binding CommerceEstimateText}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding CurrentUser.Credits, StringFormat=当前余额：{0} 积分}" Margin="0,12,0,0" /></StackPanel></Border><Button Style="{StaticResource ButtonBase}" Content="重新估算" Command="{Binding EstimateCommerceCommand}" Margin="0,16,0,0" /><Button Style="{StaticResource PrimaryButton}" Content="确认并开始生成" Command="{Binding GenerateCommerceCommand}" Margin="0,9,0,0" MinHeight="44" /></StackPanel></Border>
                            </Grid>

                            <Grid Visibility="{Binding IsTranslationWorkflow, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,18,0"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="1. 待翻译图片" /><TextBlock Text="JPG / PNG / WebP / HEIC · 最多 10 张 · 单张 25MB · 合计 28MB" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16" /><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Content="选择或继续添加图片" Click="ChooseTranslationImages_Click" /><Button Style="{StaticResource ButtonBase}" Content="清空" Click="ClearTranslationImages_Click" Margin="8,0,0,0" /></StackPanel><ItemsControl ItemsSource="{Binding TranslationImagePaths}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding TranslationImagePaths.Count, StringFormat=已选择 {0} 张}" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" /></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" VerticalAlignment="Top"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="2. 翻译与输出" /><TextBlock Style="{StaticResource FieldLabel}" Text="目标语言" Margin="0,16,0,6" /><ComboBox ItemsSource="{Binding TranslationLanguages}" SelectedItem="{Binding SelectedTranslationLanguage}" DisplayMemberPath="Name" /><TextBlock Style="{StaticResource FieldLabel}" Text="输出清晰度" Margin="0,14,0,6" /><ComboBox ItemsSource="{Binding TranslationResolutions}" SelectedItem="{Binding TranslationResolution}" /><Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="预计消耗" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding TranslationEstimatedCost, StringFormat={}{0} 积分}" FontSize="28" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="{Binding TranslationEstimateText}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /><TextBlock Text="{Binding CurrentUser.Credits, StringFormat=当前余额：{0} 积分}" Margin="0,12,0,0" /></StackPanel></Border><Button Style="{StaticResource PrimaryButton}" Content="确认并开始翻译" Command="{Binding GenerateTranslationCommand}" Margin="0,16,0,0" MinHeight="44" /></StackPanel></Border>
                            </Grid>

                            <Grid Visibility="{Binding IsDomesticWorkflow, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,0,18,0"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="国内电商商品图" /><UniformGrid Columns="2" Margin="0,16,0,0"><StackPanel Margin="0,0,7,10"><TextBlock Style="{StaticResource FieldLabel}" Text="商品名称 *" /><TextBox Text="{Binding DomesticProductName}" /></StackPanel><StackPanel Margin="7,0,0,10"><TextBlock Style="{StaticResource FieldLabel}" Text="品牌" /><TextBox Text="{Binding DomesticBrand}" /></StackPanel><StackPanel Margin="0,0,7,0"><TextBlock Style="{StaticResource FieldLabel}" Text="平台" /><ComboBox ItemsSource="{Binding DomesticPlatforms}" SelectedItem="{Binding DomesticPlatform}" /></StackPanel><StackPanel Margin="7,0,0,0"><TextBlock Style="{StaticResource FieldLabel}" Text="图片用途" /><ComboBox ItemsSource="{Binding DomesticUsages}" SelectedItem="{Binding DomesticUsage}" /></StackPanel></UniformGrid><TextBlock Style="{StaticResource FieldLabel}" Text="画面、卖点与文字要求 *" Margin="0,14,0,6" /><TextBox Text="{Binding DomesticPrompt}" AcceptsReturn="True" Height="150" VerticalContentAlignment="Top" /><TextBlock Text="AI 会结合平台与用途组织画面，但不会擅自补充未经确认的参数、认证或功效。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" /><WrapPanel Margin="0,14,0,0"><Button Style="{StaticResource ButtonBase}" Content="选择商品参考图" Click="ChooseDomesticReference_Click" /><Button Style="{StaticResource ButtonBase}" Content="清除" Click="ClearDomesticReference_Click" Margin="8,0,0,0" /><TextBlock Text="{Binding DomesticReferencePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280" ToolTip="{Binding DomesticReferencePath}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" /></WrapPanel></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" VerticalAlignment="Top"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="输出与提交" /><TextBlock Style="{StaticResource FieldLabel}" Text="输出尺寸" Margin="0,16,0,6" /><ComboBox ItemsSource="{Binding AiSizes}" SelectedItem="{Binding DomesticSize}" /><Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="{Binding DomesticEstimateText}" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentUser.Credits, StringFormat=当前余额：{0} 积分}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel></Border><Button Style="{StaticResource ButtonBase}" Content="重新估算" Command="{Binding EstimateDomesticCommand}" Margin="0,16,0,0" /><Button Style="{StaticResource PrimaryButton}" Content="确认并生成图片" Command="{Binding GenerateDomesticCommand}" Margin="0,9,0,0" /></StackPanel></Border>
                            </Grid>
                        </StackPanel></ScrollViewer>
                    </TabItem>

                    <!-- Video -->
                    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="0.75*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0"><TextBlock Style="{StaticResource PageTitle}" Text="商品视频" /><TextBlock Style="{StaticResource MutedText}" Text="按需选择模型、时长、比例与画面方向，提交前清楚展示本次积分。" Margin="0,7,0,20" />
                            <Border Style="{StaticResource PanelBorder}"><StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="任务标题" /><TextBox Text="{Binding VideoTitle}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="商品与镜头需求" Margin="0,14,0,6" /><TextBox Text="{Binding VideoPrompt}" AcceptsReturn="True" Height="130" VerticalContentAlignment="Top" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="模型" Margin="0,14,0,6" /><ComboBox ItemsSource="{Binding VideoModels}" SelectedItem="{Binding SelectedVideoModel}" DisplayMemberPath="Name" />
                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="分辨率" /><ComboBox ItemsSource="{Binding VideoResolutions}" SelectedItem="{Binding VideoResolution}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="时长" /><ComboBox ItemsSource="{Binding VideoDurations}" SelectedItem="{Binding VideoDuration}" /></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabel}" Text="比例" /><ComboBox ItemsSource="{Binding VideoRatios}" SelectedItem="{Binding VideoRatio}" /></StackPanel>
                                </Grid>
                                <CheckBox Content="同步生成音轨（是否可用由模型配置决定）" IsChecked="{Binding VideoGenerateAudio}" Margin="0,16,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Style="{StaticResource ButtonBase}" Content="选择参考图片" Click="ChooseVideoReferences_Click" /><Button Style="{StaticResource ButtonBase}" Content="清空" Click="ClearVideoReferences_Click" Margin="8,0,0,0" /><TextBlock Text="{Binding VideoReferencePaths.Count, StringFormat=已选择 {0} 张}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                                <Button Style="{StaticResource ButtonBase}" Content="AI 优化分镜脚本" Command="{Binding PreviewVideoScriptCommand}" Margin="0,16,0,0" />
                                <TextBlock Text="{Binding VideoScriptPreview}" TextWrapping="Wrap" Background="{StaticResource PanelAltBrush}" Padding="12" Margin="0,10,0,0" />
                            </StackPanel></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1"><Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="提交确认" /><TextBlock Text="{Binding SelectedVideoModel.Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" /><TextBlock Text="{Binding VideoEstimatedCost, StringFormat={}{0} 积分 / 条}" FontSize="26" FontWeight="Bold" Margin="0,18,0,0" /><TextBlock Text="{Binding CurrentUser.Credits, StringFormat=当前余额：{0} 积分}" Margin="0,6,0,0" /><Button Style="{StaticResource PrimaryButton}" Content="确认生成 1 条视频" Command="{Binding GenerateVideoCommand}" Margin="0,18,0,0" MinHeight="44" /></StackPanel></Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="最近视频" /><ItemsControl ItemsSource="{Binding VideoTasks}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Specification}" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource PrimaryBrush}" /></StackPanel><Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="播放" IsEnabled="{Binding HasResult}" ToolTip="{Binding ResultActionHint}" Command="{Binding DataContext.OpenVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        </StackPanel>
                    </Grid></ScrollViewer></TabItem>

                    <!-- AI create -->
                    <TabItem>
                        <Grid Margin="28">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="AI 创作" />
                                <TextBlock Style="{StaticResource MutedText}" Text="单次创作、连续改图和文案协作分开处理，结果仍统一沉淀到历史记录。" Margin="0,7,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,18,0,16">
                                <UniformGrid Columns="3" MaxWidth="720" HorizontalAlignment="Left">
                                    <Button Style="{StaticResource ButtonBase}" Background="{Binding SelectedAiModeIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=0}" Command="{Binding SelectAiModeCommand}" CommandParameter="0" Margin="0,0,4,0" MinHeight="42"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" /><TextBlock Text="自由创作" FontWeight="SemiBold" /></StackPanel></Button>
                                    <Button Style="{StaticResource ButtonBase}" Background="{Binding SelectedAiModeIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=1}" Command="{Binding SelectAiModeCommand}" CommandParameter="1" Margin="2,0" MinHeight="42"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" /><TextBlock Text="对话生图" FontWeight="SemiBold" /></StackPanel></Button>
                                    <Button Style="{StaticResource ButtonBase}" Background="{Binding SelectedAiModeIndex, Converter={StaticResource SelectedPageBrush}, ConverterParameter=2}" Command="{Binding SelectAiModeCommand}" CommandParameter="2" Margin="4,0,0,0" MinHeight="42"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" /><TextBlock Text="文案 Agent" FontWeight="SemiBold" /></StackPanel></Button>
                                </UniformGrid>
                            </Border>

                            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedAiModeIndex}" Background="Transparent" BorderThickness="0">
                                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style></TabControl.Resources>

                                <!-- Free creative -->
                                <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,24">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PanelBorder}"><StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="自由创作" />
                                            <TextBlock Text="一句话描述画面；参考图、风格和尺寸按需填写。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="画面要求 *" />
                                            <TextBox Text="{Binding FreePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150" VerticalContentAlignment="Top" ToolTip="描述主体、场景、构图、光线及必须保留的内容" />
                                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="视觉风格" /><TextBox Text="{Binding FreeStyle}" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="尺寸" /><ComboBox ItemsSource="{Binding AiSizes}" SelectedItem="{Binding FreeSize}" /></StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding FreeStyles}" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ButtonBase}" Content="{Binding}" Command="{Binding DataContext.SetFreeStyleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5" MinHeight="30" Margin="0,0,7,7" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="参考图（可选，最多 10 张）" Margin="0,16,0,6" />
